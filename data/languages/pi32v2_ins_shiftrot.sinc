##################
#
# Shift/Rotate
#
##################

# TODO: if immediate shamt is 0 then it's 32 or 64, if we're doing it with doubled registers

###########################################################################################
# Logical shift left
###########################################################################################

#
# rA <<= rB
# => lsl rA, rB
#
:lsl regAl, regBl is group=0 & ins0712=0x34 & ins0303=0 & regAl & regBl
{
	regAl = regAl << regBl;
}

# 
# rA = rB << shamt
# => lsl rA, rB, shamt
#
:lsl regAl, regBl, imm0812 is group=5 & ins0707=0 & ins0303=0 & regAl & regBl & imm0812
{
	regAl = regBl << imm0812;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:lsl eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=0
{
	eregA = eregB << eregC;
}

# 
# rA = rC << rB (r0 to r15)
# => lsl rA, rB, rC
:lsl eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=1
{
	eregA = eregB << eregC;
}

#
# rA = rB << #imm6
# => lsl rA, rB, imm6
:lsl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=0 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB << imm6;
}

###########################################################################################
# Logical shift right
###########################################################################################

#
# rA >>= rB
# => lsr rA, rB
#
:lsr regAl, regBl is group=0 & ins0712=0x35 & ins0303=0 & regAl & regBl
{
	regAl = regAl >> regBl;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:lsr eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=2
{
	eregA = eregB >> eregC;
}

#
# rA = rB >> shamt
# => lsr rA, rB, shamt
#
:lsr regAl, regBl, imm0812 is group=5 & ins0707=1 & ins0303=0 & regAl & regBl & imm0812
{
	regAl = regBl >> imm0812;
}

#
# rA = rB >> imm6
# => lsl rA, rB, imm6
:lsl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=2 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB >> imm6;
}

#
# rA_rB >>= #imm6
#
:lsr edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=0 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA >> imm6;
}

#
# rA_rB <<= #imm6
#
:lsl edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=2 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA << imm6;
}

#
# rA_rB >>>= #imm6 (arithmetic/signed)
#
# Sibling of lsr/lsl above in the same ins0011=0x1d0 slot (imm2627=0/2); the
# 3rd value seen in real firmware is imm2627=3, confirmed against every real
# occurrence (5 addresses, 4 distinct pair registers and immediates 39/48/56/
# 63). imm2627=1 is not evidenced anywhere in ground truth and is left
# unimplemented rather than guessed at.
:qasr edregA, #imm6 is group=7 & ins0011=0x1d0 ; edregA & imm2627=3 & eregB=0 & imm1619 & imm2425
[ imm6 = (imm2425 << 4) | imm1619; ]
{
    edregA = edregA s>> imm6;
}

#
# rA_rB <<= rC / rA_rB >>= rC (64-bit pair shifted by a register-held count)
#
# Distinct opcode slot (ins0012=0x1d8, a 13-bit match vs. the 12-bit
# ins0011=0x1d0 immediate-shift family above) confirmed against every real
# ground-truth occurrence (26 addresses total): edregA (bits 29-31, the
# existing pair-register field) is the shifted operand, eregC (bits 24-27,
# the existing plain-register field) holds the shift count, and the low
# byte's bit 17 alone (imm1623, reused as an 8-bit exact-match rather than a
# single named bit since every other bit in that byte was 0 in all samples)
# selects direction: 0x00 = left, 0x02 = right. Only the logical (unsigned)
# right shift is evidenced -- no arithmetic/signed variant appears anywhere
# in ground truth, so none is added here.
:lsl edregA, eregC is group=7 & ins0012=0x1d8 ; edregA & eregC & imm2828=0 & imm1623=0x00
{
    edregA = edregA << eregC;
}

:lsr edregA, eregC is group=7 & ins0012=0x1d8 ; edregA & eregC & imm2828=0 & imm1623=0x02
{
    edregA = edregA >> eregC;
}

###########################################################################################
# (Q) Arithmetic shift left
###########################################################################################

### TODO: overflow? ###

#
# rA <<<= rB
# => qasl rA, rB
#
:qasl regAl, regBl is group=0 & ins0712=0x34 & ins0303=1 & regAl & regBl
{
	regAl = regAl << regBl;
}

#
# rA = rB <<< shamt
# => qasl rA, rB, shamt
#
:qasl regAl, regBl, imm0812 is group=5 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl << imm0812;
}

#
# rA = rB <<< imm6
# => qasl rA, rB, imm6
:qasl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=1 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB << imm6;
}

###########################################################################################
# (Q) Arithmentic shift right
###########################################################################################

#
# rA >>>= rB
# => qasr rA, rB
#
:qasr regAl, regBl is group=0 & ins0712=0x35 & ins0303=1 & regAl & regBl
{
	regAl = regAl s>> regBl;
}

#
# rA = rB >>> shamt
# => qasr rA, rB, shamt
#
:qasr regAl, regBl, imm0812 is group=5 & ins0707=1 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl s>> imm0812;
}

# 
# rA = rC >> rB (r0 to r15)
# => lsr rA, rB, rC
:qasr eregA, eregB, eregC is group=7 & ins0011=0x1c8 ; eregA & eregC & eregB & imm1619=3
{
	eregA = eregB s>> eregC;
}

#
# rA = rB >>> imm6
# => qasr rA, rB, imm6
:qasl eregA, eregB, imm6 is group=7 & ins0011=0x1c0 ; eregA & eregB & imm2627=3 & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = eregB s>> imm6;
}


###########################################################################################
# Logical shift left + right (used for alignment)
###########################################################################################

#
# rA = rB <> #imm6
#
:lslr eregA, eregB, #imm6 is group=7 & ins0011=0x1c4 ; eregA & eregB & imm2425 & imm1619
[imm6 = (imm2425 << 4) | imm1619;]
{
    eregA = (eregB << imm6) >> imm6;
}

###########################################################################################
# Memory-operand compound-assign shifts: [rA+offset] <<=/>>=/>>>= shamt5
#
# Same base opcode (ins0111=0x436, an 11-bit selector that deliberately
# excludes word1's bit0 -- see below) and the same eregA+offset addressing
# fields as the "[rA+imm8] |= rB" / "^= rB" family above in
# pi32v2_ins_logicops.sinc, but for a 5-bit immediate shift amount instead of
# a register operand, with imm1617 selecting the direction the same way it
# already selects OR(0) vs XOR(1) there: 0=<<, 2=>>(logical), 3=>>>(signed).
#
# Confirmed against all 8 real ground-truth occurrences: the 5-bit shift
# amount is split across word1's bit0 (imm0000, contributing the amount's top
# bit, worth 16) and word2's bits8-11 (imm2427, the low 4 bits) -- e.g.
# shift=22 decodes as imm0000=1 (word1=...6D, odd) & imm2427=6 (16+6=22),
# while shift=6/8 decode as imm0000=0 (word1=...6C, even) & imm2427=6/8.
# ins0111 (bits1-11, i.e. ins0011 with the LSB masked out) is therefore the
# real fixed opcode selector; imm0000 is a genuine operand bit, not part of
# the opcode, despite living in the same byte as ins0011's other fixed bits.
###########################################################################################

#
# [rA+offset] <<= shamt5
#
:lsl "["eregA+offset"]", #shamt5 is group=7 & ins0111=0x436 & imm0000 ; eregA & imm2427 & imm1823 & imm1617=0
[ offset = imm1823 << 2; shamt5 = (imm0000 << 4) | imm2427; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr << shamt5;
}

#
# [rA+offset] >>= shamt5  (logical/unsigned)
#
:lsr "["eregA+offset"]", #shamt5 is group=7 & ins0111=0x436 & imm0000 ; eregA & imm2427 & imm1823 & imm1617=2
[ offset = imm1823 << 2; shamt5 = (imm0000 << 4) | imm2427; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr >> shamt5;
}

#
# [rA+offset] >>>= shamt5  (arithmetic/signed)
#
:qasr "["eregA+offset"]", #shamt5 is group=7 & ins0111=0x436 & imm0000 ; eregA & imm2427 & imm1823 & imm1617=3
[ offset = imm1823 << 2; shamt5 = (imm0000 << 4) | imm2427; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *:4 addr s>> shamt5;
}