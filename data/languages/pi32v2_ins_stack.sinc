##################
#
# Stack Operations
#
##################

macro pushreg(reg) { mult_addr = mult_addr - 4; *mult_addr = reg; }
macro popreg(reg) { reg = *mult_addr; mult_addr = mult_addr + 4;}


#######################################
# Registers bitmap to register list
#######################################

# Push register based on counter
pshmapreg: r0 is counter=0 & r0 {pushreg(r0);}
pshmapreg: r1 is counter=1 & r1 {pushreg(r1);}
pshmapreg: r2 is counter=2 & r2 {pushreg(r2);}
pshmapreg: r3 is counter=3 & r3 {pushreg(r3);}
pshmapreg: r4 is counter=4 & r4 {pushreg(r4);}
pshmapreg: r5 is counter=5 & r5 {pushreg(r5);}
pshmapreg: r6 is counter=6 & r6 {pushreg(r6);}
pshmapreg: r7 is counter=7 & r7 {pushreg(r7);}
pshmapreg: r8 is counter=8 & r8 {pushreg(r8);}
pshmapreg: r9 is counter=9 & r9 {pushreg(r9);}
pshmapreg: r10 is counter=10 & r10 {pushreg(r10);}
pshmapreg: r11 is counter=11 & r11 {pushreg(r11);}
pshmapreg: r12 is counter=12 & r12 {pushreg(r12);}
pshmapreg: r13 is counter=13 & r13 {pushreg(r13);}
pshmapreg: r14 is counter=14 & r14 {pushreg(r14);}
pshmapreg: r15 is counter=15 & r15 {pushreg(r15);}

# Pop registers based on counter
popmapreg: r0 is counter=0 & r0 {popreg(r0);}
popmapreg: r1 is counter=1 & r1 {popreg(r1);}
popmapreg: r2 is counter=2 & r2 {popreg(r2);}
popmapreg: r3 is counter=3 & r3 {popreg(r3);}
popmapreg: r4 is counter=4 & r4 {popreg(r4);}
popmapreg: r5 is counter=5 & r5 {popreg(r5);}
popmapreg: r6 is counter=6 & r6 {popreg(r6);}
popmapreg: r7 is counter=7 & r7 {popreg(r7);}
popmapreg: r8 is counter=8 & r8 {popreg(r8);}
popmapreg: r9 is counter=9 & r9 {popreg(r9);}
popmapreg: r10 is counter=10 & r10 {popreg(r10);}
popmapreg: r11 is counter=11 & r11 {popreg(r11);}
popmapreg: r12 is counter=12 & r12 {popreg(r12);}
popmapreg: r13 is counter=13 & r13 {popreg(r13);}
popmapreg: r14 is counter=14 & r14 {popreg(r14);}
popmapreg: r15 is counter=15 & r15 {popreg(r15);}

# Pop special registers based on counter
popmapsreg: reti is counter=0 & reti {popreg(reti);}
popmapsreg: rete is counter=1 & rete {popreg(rete);}
popmapsreg: retx is counter=2 & retx {popreg(retx);}
popmapsreg: rets is counter=3 & rets {popreg(rets);}
popmapsreg: sr4 is counter=4 & sr4 {popreg(sr4);}
popmapsreg: psr is counter=5 & psr {popreg(psr);}
popmapsreg: cnum is counter=6 & cnum {popreg(cnum);}
popmapsreg: sr7 is counter=7 & sr7 {popreg(sr7);}

# Push special registers based on counter (mirrors popmapsreg above; only
# the {reti,rete,retx,rets} bitmap slots -- counter 0-3 -- are used by the
# generic push-direction special-register-list constructors below).
pshmapsreg: reti is counter=0 & reti {pushreg(reti);}
pshmapsreg: rete is counter=1 & rete {pushreg(rete);}
pshmapsreg: retx is counter=2 & retx {pushreg(retx);}
pshmapsreg: rets is counter=3 & rets {pushreg(rets);}

# Bit ops
next: is epsilon [counter=counter+1;]{}
prev: is epsilon [counter=counter-1;]{}
mregread: is imm1631 [bitset=(imm1631 & (1 << counter))>>counter;]{}
msregread: is imm0003 [bitset=(imm0003 & (1 << counter))>>counter;]{}
pshmreg: pshmapreg is pshmapreg & bitset=1 [sep=1;]{}
pshmreg: is bitset=0 {}
popmreg: popmapreg is popmapreg & bitset=1 [sep=1;]{}
popmreg: is bitset=0 {}
popmsreg: popmapsreg is popmapsreg & bitset=1 [sep=1;]{}
popmsreg: is bitset=0 {}
pshmsreg: pshmapsreg is pshmapsreg & bitset=1 [sep=1;]{}
pshmsreg: is bitset=0 {}
msep: "," is  sep=1 & bitset=1 {}
msep: "" is sep=0 | bitset=0 {}

# Recursively generate our push registers
pshmapregs: pshmapregs^pshmreg^msep is counter<15 & mregread & msep & pshmreg & next & pshmapregs
    { build pshmapregs; build pshmreg; }
pshmapregs: pshmreg is counter=15 & mregread & pshmreg {}
pshmap: pshmapregs is pshmapregs [bitset=0; counter=0; sep=0;] {}


# Recursively generate our pop registers
popmapregs: popmapregs^popmreg^msep is counter<15 & mregread & msep & popmreg & next & popmapregs
    { build popmreg; build popmapregs; }
popmapregs: popmreg is counter=15 & mregread & popmreg {}
popmap: popmapregs is popmapregs [bitset=0; counter=0; sep=0;] {}

# Recursively generate our pop special registers
popmapsregs: popmapsregs^popmsreg^msep is counter<3 & msregread & msep & popmsreg & next & popmapsregs
    { build popmsreg; build popmapsregs; }
popmapsregs: popmsreg^msep is counter=3 & msep & msregread & popmsreg {}
popsrmap: popmapsregs is popmapsregs [bitset=0; counter=0; sep=0;]{}

# Recursively generate our push special registers list. Push order is the
# reverse of pop order (rets first / outermost, reti last / innermost) --
# i.e. descending counter, using `prev` -- mirroring the LIFO push/pop
# symmetry already established by the {psr,rets,reti} pcode further below
# (left-most displayed register is always the first one physically pushed,
# and correspondingly the last one popped).
pshmapsregs: pshmsreg^msep^pshmapsregs is counter>0 & msregread & pshmsreg & msep & prev & pshmapsregs
    { build pshmsreg; build pshmapsregs; }
pshmapsregs: pshmsreg is counter=0 & msregread & pshmsreg {}
pshsrmap: pshmapsregs is pshmapsregs [bitset=0; counter=3; sep=0;]{}

#######################################
# Registers boundary to register list
#######################################

rlpshreg: pshmapreg is pshmapreg [sep=1;]{}
rlpopreg: popmapreg is popmapreg [sep=1;]{}

##
# Some variants of push and pop accept a single-byte operand
# specifying a register boundary (upper or lower). The
# following tables are used to generate the corresponding
# registers list and associated p-code.
#
# All these tables use the `counter` context register to
# iterate over the registers, the `sep` context bit to
# indicate when a separator is required and force the
# `bitset` context bit to 1 in order to use the
# `msep` table.
#
# - pushreglist4: push registers from rX to r4 (with X>=4)
# - popreglist4: pop registers from r4 to rX (with X>=4)
# - pushreglist3: push registers from r3 to rX (with X<=3)
# - popreglist3: pop registers from rX to r3 (with X<=3)
# - pushreglist0: push registers from rX to r0 (X>=0)
# - popreglist0: pop registers from r0 to rX (x>=0)
##

pshrl4: msep^rlpshreg^pshrl4 is counter>4 & msep & rlpshreg & prev & pshrl4 
    { build rlpshreg; build pshrl4; }
pshrl4: msep^rlpshreg is counter=4 & msep & rlpshreg {}
pushreglist4: pshrl4 is pshrl4 [sep=0; bitset=1;]{}

# Pop regs from counter to r4
poprl4: msep^rlpopreg^poprl4 is counter>4 & msep & rlpopreg & prev & poprl4 
    {build rlpopreg; build poprl4; }
poprl4: msep^rlpopreg is counter=4 & msep & rlpopreg {}
popreglist4: poprl4 is poprl4 [sep=0; bitset=1; ]{}

# Push regs from counter to r3
pshrl3: pshrl3^rlpshreg^msep is counter<3 & msep & rlpshreg & next & pshrl3 
    {build pshrl3; build rlpshreg;}
pshrl3: rlpshreg^msep is counter=3 & msep & rlpshreg {}
pushreglist3: pshrl3 is pshrl3 [sep=0; bitset=1;]{}

# Pop regs from counter to r0
poprl3: poprl3^rlpopreg^msep is counter<3 & msep & rlpopreg & next & poprl3 
    {build rlpopreg; build poprl3; }
poprl3: rlpopreg^msep is counter=3 & msep & rlpopreg {}
popreglist3: poprl3 is poprl3 [sep=0; bitset=1; ]{}


##
# Some helpers (from @kagaimiq and adapted)
##

# Push rets and then reglist (rX...r4)
pshretsregs: {rets,pushreglist4} is pushreglist4 & rets & ins0003
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    pushreg(rets);
    build pushreglist4;
    sp = mult_addr;
}

# Pop reglist (r4...rX) and then pc
poppcregs: {pc,popreglist4} is popreglist4 & pc & ins0003
[counter=ins0003 & 0x0f;]
{
    mult_addr = sp;
    build popreglist4;
    popreg(pc);
    sp = mult_addr;
    return [pc];
}

# Pop rets and then reglist (r3...rX, X<=3) -- sibling of pshretsregs above,
# needed for the ins0003<4 half of the {rets,...} pop-list family (nibble 3
# of the ins0407-based family below; see the constructors that reference it).
popretsregs3: {rets,popreglist3} is popreglist3 & rets & ins0003
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    build popreglist3;
    popreg(rets);
    sp = mult_addr;
}

# Pop reglist (r3...rX, X<=3) and then pc -- sibling of poppcregs above,
# needed for the ins0003<4 half of the {pc,...} pop-list family.
poppcregs3: {pc,popreglist3} is popreglist3 & pc & ins0003
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    build popreglist3;
    popreg(pc);
    sp = mult_addr;
    return [pc];
}

# Push rets and then reglist (r3...rX, X<=3) -- sibling of pshretsregs above,
# needed for the ins0003<4 half of the {rets,...} push-list family.
pshretsregs3: {rets,pushreglist3} is pushreglist3 & rets & ins0003
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    pushreg(rets);
    build pushreglist3;
    sp = mult_addr;
}

#
# pc = [sp++]
# => pop pc
#
:pop pc is group=0 & ins0012=0x0400 & pc
{
    mult_addr = sp;
	popreg(pc);
    sp = mult_addr;
	return [pc];
}

#
# [--sp] = rets
# => push rets
#
:push rets is group=0 & ins0012=0x0410 & rets
{
    mult_addr = sp;
	pushreg(rets);
    sp = mult_addr;
}


##############################################################################
# Multi-register range-list / special-register-list push/pop family
#
# This whole family shares a fixed second byte 0x04 (i.e. ins0812=0x04 --
# equivalently ins0412 = ins0407 + 0x40 for every constructor below, since
# the fixed 0x04 upper byte always contributes exactly +0x40 to the 9-bit
# ins0412 field) and uses the top nibble of the low byte (ins0407) as an
# opcode-family selector, with the low nibble (ins0003) as either a
# 4-bit "range count" (nibbles 3-7) or a 4-bit register-presence bitmap
# (nibbles 8-f). Confirmed against research/disasm/app_full_disasm_llvm.txt,
# including an apparent exhaustive self-test/opcode-enumeration table at
# 0x2093e00-0x2094642 that walks nearly every nibble/count combination in
# this family (and several neighboring families) in strict sequence --
# an unusually strong ground-truth source for validating the bitfield
# formulas below against every value, not just the combinations that
# happen to occur "organically" elsewhere in the binary.
#
# ins0407 nibble decode:
#   0x1 : push rets alone, no range (only ins0003=0 observed/handled)
#   0x3 : pop  {rets, range}      (range = r3..rN for N<4, rN..r4 for N>=4)
#   0x4 : pop  {range}
#   0x5 : pop  {pc, range}
#   0x6 : push {range}
#   0x7 : push {rets, range}
#   0x8 : pop  {bitmap}                (bitmap over reti/rete/retx/rets)
#   0x9 : pop  {sr4, bitmap}
#   0xa : pop  {psr, bitmap}
#   0xb : pop  {psr, sr4, bitmap}
#   0xc : push {bitmap}
#   0xd : push {sr4, bitmap}
#   0xe : push {psr, bitmap}
#   0xf : push {psr, sr4, bitmap}
#
# Note on known cosmetic limitation: popsrmap/pshsrmap's recursive bitmap
# builder (like the pre-existing group=7 pshmap/popmap machinery it mirrors)
# can render incorrectly when this family's own context bits happen to
# carry over between two back-to-back instructions of this same family
# during a forced linear sweep (observed on already-shipped nibble-0x8
# occurrences, e.g. two adjacent real {bitmap} pops rendering with a
# spurious leading separator or a dropped register) -- a pre-existing
# quirk of this context-register-driven list-building idiom, not something
# newly introduced here. It does not affect instruction length/decode
# (the property this differential-testing methodology actually measures),
# only cosmetic display text in that specific adjacency case.
##############################################################################

#
# {rets, regs...} = [sp++]  (nibble 3, ins0003 >= 4: rets + rN..r4)
# => pop {rets, regs...}
#
:pop {rets, popreglist4} is group=0 & ins0412=0x043 & ins0003>=4 & ins0003 & popreglist4 & rets
[ counter=ins0003 & 0x0f; ]
{
    mult_addr = sp;
    popreg(rets);
    build popreglist4;
    sp = mult_addr;
}

#
# {rets, regs...} = [sp++]  (nibble 3, ins0003 < 4: rets + r3..rN)
# => pop {rets, regs...}
#
:pop {popretsregs3} is group=0 & ins0412=0x043 & ins0003<4 & popretsregs3
{
    mult_addr = sp;
    build popretsregs3;
    sp = mult_addr;
}

#
# {regs...} = [sp++]  (nibble 4, ins0003 < 4: r3..rN)
# => pop {regs...}
#
:pop {popreglist3} is group=0 & ins0412=0x044 & ins0003<4 & ins0003 & popreglist3
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build popreglist3;
    sp = mult_addr;
}

#
# {regs...} = [sp++]  (nibble 4, ins0003 >= 4: rN..r4)
# => pop {regs...}
#
:pop {popreglist4} is group=0 & ins0412=0x044 & ins0003>=4 & ins0003 & popreglist4
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build popreglist4;
    sp = mult_addr;
}

#
# {sregs...} = [sp++]  (nibble 8: bitmap over reti/rete/retx/rets)
# => pop {sregs...}
#
:pop {popsrmap} is group=0 & ins0412=0x048 ... & popsrmap
{
    mult_addr = sp;
    build popsrmap;
    sp = mult_addr;
}

#
# {sr4} = [sp++] / {sr4, sregs...} = [sp++]  (nibble 9)
# => pop {sr4[, sregs...]}
#
# Note: sr4/psr here are printed as bare literal text (not bound register
# operands) and pushed/popped by directly naming the global register in
# pcode. They cannot be matched as a `sregA`-attached operand field the way
# rets/pc/reti are elsewhere in this file, because that field physically
# aliases the same bits (0,3) that ins0003 uses as the reti/rete/retx/rets
# bitmap in this family -- binding both in the same constructor produced a
# genuine pattern conflict ("Pattern size cannot vary") since the two
# interpretations of those bits are mutually exclusive here.
:pop {"sr4,",popsrmap} is group=0 & ins0412=0x049 ... & popsrmap
{
    mult_addr = sp;
    build popsrmap;
    popreg(sr4);
    sp = mult_addr;
}

#
# {psr} = [sp++] / {psr, sregs...} = [sp++]  (nibble a)
# => pop {psr[, sregs...]}
#
:pop {"psr,",popsrmap} is group=0 & ins0412=0x04a ... & popsrmap
{
    mult_addr = sp;
    build popsrmap;
    popreg(psr);
    sp = mult_addr;
}

#
# {psr, sr4} = [sp++] / {psr, sr4, sregs...} = [sp++]  (nibble b)
# => pop {psr, sr4[, sregs...]}
#
:pop {"psr,sr4,",popsrmap} is group=0 & ins0412=0x04b ... & popsrmap
{
    mult_addr = sp;
    build popsrmap;
    popreg(sr4);
    popreg(psr);
    sp = mult_addr;
}

#
# {pc, regs...} = [sp++]  (nibble 5, ins0003 >= 4: pc + rN..r4)
# => pop {pc, regs...}
#
:pop poppcregs is group=0 & ins0412=0x045 & ins0003>=4 & ins0003 & poppcregs
{
    mult_addr = sp;
    build poppcregs;
    sp = mult_addr;
}

#
# {pc, regs...} = [sp++]  (nibble 5, ins0003 < 4: pc + r3..rN)
# => pop {pc, regs...}
#
:pop poppcregs3 is group=0 & ins0412=0x045 & ins0003<4 & poppcregs3
{
    mult_addr = sp;
    build poppcregs3;
    sp = mult_addr;
}

#
# [--sp] = {regs...}  (nibble 6, ins0003 < 4: r3..rN, including ins0003=0
# i.e. the full r3-r0 range -- previously incorrectly guarded to exclude
# this case)
# => push {regs...}
#
:push {pushreglist3} is group=0 & ins0412=0x046 & ins0003<4 & ins0003 & pushreglist3
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build pushreglist3;
    sp = mult_addr;
}

#
# [--sp] = {regs...}  (nibble 6, ins0003 >= 4: rN..r4)
# => push {regs...}
#
:push {pushreglist4} is group=0 & ins0412=0x046 & ins0003>=4 & ins0003 & pushreglist4
[ counter = ins0003 & 0xf; ]
{
    mult_addr = sp;
    build pushreglist4;
    sp = mult_addr;
}

#
# [--sp] = {rets, regs...}  (nibble 7, ins0003 >= 4: rets + rN..r4)
# => push {rets, regs...}
#
:push pshretsregs is group=0 & ins0412=0x047 & ins0003>=4 & pshretsregs
{
    mult_addr = sp;
    build pshretsregs;
    sp = mult_addr;
}

#
# [--sp] = {rets, regs...}  (nibble 7, ins0003 < 4: rets + r3..rN)
# => push {rets, regs...}
#
:push pshretsregs3 is group=0 & ins0412=0x047 & ins0003<4 & pshretsregs3
{
    mult_addr = sp;
    build pshretsregs3;
    sp = mult_addr;
}

#
# [--sp] = {sregs...}  (nibble c: bitmap over reti/rete/retx/rets)
# => push {sregs...}
#
:push {pshsrmap} is group=0 & ins0412=0x04c ... & pshsrmap
{
    mult_addr = sp;
    build pshsrmap;
    sp = mult_addr;
}

#
# [--sp] = {sr4} / [--sp] = {sr4, sregs...}  (nibble d)
# => push {sr4[, sregs...]}
#
:push {"sr4,",pshsrmap} is group=0 & ins0412=0x04d ... & pshsrmap
{
    mult_addr = sp;
    pushreg(sr4);
    build pshsrmap;
    sp = mult_addr;
}

#
# [--sp] = {psr} / [--sp] = {psr, sregs...}  (nibble e)
# => push {psr[, sregs...]}
#
:push {"psr,",pshsrmap} is group=0 & ins0412=0x04e ... & pshsrmap
{
    mult_addr = sp;
    pushreg(psr);
    build pshsrmap;
    sp = mult_addr;
}

#
# [--sp] = {psr, sr4} / [--sp] = {psr, sr4, sregs...}  (nibble f)
# => push {psr, sr4[, sregs...]}
#
:push {"psr,sr4,",pshsrmap} is group=0 & ins0412=0x04f ... & pshsrmap
{
    mult_addr = sp;
    pushreg(psr);
    pushreg(sr4);
    build pshsrmap;
    sp = mult_addr;
}

#
# [--sp] = {reg, ...}
# => push {reg, ...}
#
:push {pshmap} is group=7 & ins0011=0x8D8 ; pshmap
{
    mult_addr = sp;
    build pshmap;
    sp = mult_addr;
}

#
# {reg, ...} = [sp++]
# => pop {reg, ...}
#
:pop {popmap} is group=7 & ins0011=0x8D4 ; popmap
{
    mult_addr = sp;
    build popmap;
    sp = mult_addr;
}

#
# [--sp] = {rets, reg, ...}
# => push {rets, reg, ...}
#
:push {rets, pshmap} is group=7 & ins0011=0x8D9 & rets ; pshmap
{
    mult_addr = sp;
    pushreg(rets);
    build pshmap;
    sp = mult_addr;
}

#
# {rets, reg, ...} = [sp++]
# => pop {rets, reg, ...}
#
:pop {pc, popmap} is group=7 & ins0011=0x8D5 & pc ; popmap
{
    mult_addr = sp;
    build popmap;
    popreg(pc);
    sp = mult_addr;
    return [pc];
}

#
# [sp+imm5] = rA
# => sw rA, [sp]
#
:sw regA, [sp] is group=1 & ins0407=0x8 & regA & imm0812=0 & sp
{
    *:4 sp = regA;
}

#
# [sp+imm5] = rA
# => sw rA, [sp+imm5]
#
:sw regA, [sp+imm5] is group=1 & ins0407=0x8 & regA & imm0812>0 & imm0812 & sp
[ imm5 = imm0812 * 4; ]
{
    addr:4 = sp + imm5;
    *:4 addr = regA;
}

#
# [sp+imm6ext] = rA, extended-offset form (offset 128-252, step 4)
# => sw rA, [sp+imm6ext]
#
# Sibling of the 5-bit "sw regA, [sp+imm5]" constructor above, but for
# offsets that no longer fit in 5 bits: ins0407 gains bit1 (0x8|0x2=0xA) and
# bit 13 of the raw word is a fixed 1 which, semantically, is bit 5 of the
# byte-offset-divided-by-4 immediate (i.e. imm0812 covers the low 5 bits,
# and the encoding always implies the top bit of a 6-bit immediate is set).
# Confirmed against research/disasm/app_full_disasm_llvm.txt ground truth:
# every real occurrence has offset in [128,252] step 4 and bit13=1.
#
:sw regA, [sp+imm6ext] is group=1 & ins0407=0xA & regA & imm0812 & sp
[ imm6ext = (imm0812 + 32) * 4; ]
{
    addr:4 = sp + imm6ext;
    *:4 addr = regA;
}

#
# [sp+imm8] = rA
# => sw rA, [sp+imm8]
#
:sw eregA, [sp+imm8] is group=7 & ins0011=0x9d4 & sp ; eregA & imm1616=1 & imm1719 & imm2427
[ imm8 = (imm1719 << 1) | (imm2427 << 4); ]
{
    addr:4 = sp + imm8;
    *:4 addr = eregA;
}

#
# rA = [sp+#imm5]
# => lw rA, [sp+imm5]
#
:lw regA, [sp+imm5] is group=1 & ins0407=0 & regA & imm0812>0 & imm0812 & sp
[ imm5 = imm0812 * 4; ]
{
    addr:4 = sp + imm5;
    regA = *:4 addr;
}

#
# rA = [sp+imm6ext], extended-offset form (offset 128-252, step 4)
# => lw rA, [sp+imm6ext]
#
# Load-side sibling of "sw regA, [sp+imm6ext]" above -- see that comment for
# the encoding rationale. ins0407 = 0x2 (base load ins0407=0 | extended-flag
# 0x2), same imm6ext = (imm0812 + 32) * 4.
#
:lw regA, [sp+imm6ext] is group=1 & ins0407=0x2 & regA & imm0812 & sp
[ imm6ext = (imm0812 + 32) * 4; ]
{
    addr:4 = sp + imm6ext;
    regA = *:4 addr;
}

#
# rA = [sp+imm8]
# => lw rA, [sp+imm8]
#
:lw eregA, [sp+imm8] is group=7 & ins0011=0x9d4 & sp ; eregA & imm1616=0 & imm1719 & imm2427
[ imm8 = (imm1719 << 1) | (imm2427 << 4); ]
{
    addr:4 = sp + imm8;
    eregA = *:4 addr;
}

#
# d[sp+imm12] = rB_rA
# => sdw rB_rA, [sp+imm12]
#
:sdw edregA, [sp+imm12] is group=7 & ins0011=0x9d0 & sp; edregA & imm1616=1 & imm1627
[ imm12 = (imm1627 & 0xffe); ]
{
    addr:4 = sp + imm12;
    *:8 addr = edregA;
}

#
# h[sp+imm12] = rA
# => sh rA, [sp+imm12]
#
:sh eregA, [sp+imm12] is group=7 & ins0011=0x9d8 & sp; eregA & imm1616=1 & imm1627
[ imm12 = (imm1627 & 0xffe); ]
{
    addr:4 = sp + imm12;
    *:2 addr = eregA:2;
}

#
# b[sp+imm12] = rA
# => sb rA, [sp+imm12]
#
:sb eregA, [sp+imm1627] is group=7 & ins0011=0x9de & sp; eregA & imm1627
{
    addr:4 = sp + imm1627;
    *:1 addr = eregA:1;
}

#
# rA = b[sp+imm12] (s)
# => lb.s rA, [sp+imm12] (signed)
#
:lb.s eregA, [sp+imm1627] is group=7 & ins0011=0x9dd & sp ; eregA & imm1627
{
    addr:4 = sp + imm1627;
    eregA = sext(*:1 addr);
}


#
# rB_rA = d[sp+imm12]
# => ldw rB_rA, [sp+imm12]
#
:ldw edregA, [sp+imm12] is group=7 & ins0011=0x9d0 & sp; edregA & imm1616=0 & imm1627
[ imm12 = (imm1627 & 0xffe); ]
{
    addr:4 = sp + imm12;
    edregA = *:8 addr;
}

#
# rA = [sp+#imm5]
# => lw rA, [sp+imm5]
#
:lw regA, [sp] is group=1 & ins0407=0 & regA & imm0812=0 & sp
{
    regA = *:4 sp;
}


#
# rA = h[sp+imm12] (u)
# => lh rA, [sp+imm12]
#
:lh eregA, [sp+imm12] is group=7 & ins0011=0x9d8 & sp; eregA & imm1616=0 & imm1627
[ imm12 = (imm1627 & 0xffe); ]
{
    addr:4 = sp + imm12;
    eregA = *:2 addr;
}

#
# rA = h[sp+imm12] (s)
# => lh.s rA, [sp+imm12] (signed)
#
# Signed-halfword counterpart to lb.s above; sits at ins0011=0x9d9, filling
# the gap between the word family (0x9d4) and the byte family (0x9dc-0x9de).
# There is no store-side variant in the ground truth (same asymmetry as
# lb.s / sb, which don't share a code either). Confirmed against
# research/disasm/app_full_disasm_llvm.txt: reg=bits(12,15) of the second
# halfword, imm12 = imm1627*2 (always even, 136 real occurrences checked).
#
:lh.s eregA, [sp+imm12] is group=7 & ins0011=0x9d9 & sp; eregA & imm1627
[ imm12 = imm1627 << 1; ]
{
    addr:4 = sp + imm12;
    eregA = sext(*:2 addr);
}

#
# rA = [sp+imm12] (unsigned)
# => lb rA, [sp+imm12]
#
:lb eregA, [sp+imm1627] is group=7 & ins0011=0x9dc & sp; eregA & imm1627
{
    addr:4 = sp + imm1627;
    eregA = *:1 addr;
}