##################
#
# Arithmetic Operations
#
##################

###########################################################################################
# Add
###########################################################################################

#
# rA += rB
# => add rA, rB
#
:add regA, regB is group=0 & ins0812=0x18 & regA & regB
{
	regA = regA + regB;
}

#
# rA = rB + rC
# => add rA, rB, rC
#
:add regAl, regBl, regCxl is group=0 & ins0912=0xE & regAl & regBl & regCxl
{
	regAl = regBl + regCxl;
}

#
# rA += imm8
# => add rA, #imm8
#
:add regAl, #imm8 is group=1 & ins0607=3 & regAl & imm0305s & imm0812
[ imm8 = (imm0305s << 5) | imm0812; ]
{
	regAl = regAl + imm8;
}

#
# sp += imm10
# => add sp, #imm10
#
:add sp, #imm10 is group=4 & ins0004=0x02 & imm0812 & imm0507s & sp
[ imm10 = (imm0507s << 7) | (imm0812 << 2); ]
{
	sp = sp + imm10;
}

#
# sp += imm13 (extended-range form)
# => add sp, #imm13
#
# Sibling of the 10-bit-immediate "add sp, #imm10" above, needed for values
# outside its [-512,508] range (real ground-truth occurrences at -640, -608,
# 608, 640). Group=7, ins0311=0x11E (bits3-11 of word1, i.e. the low 3 bits
# 0-2 of ins0011 are NOT part of this opcode selector), second word carries
# a plain signed 13-bit immediate in its own low bits -- confirmed exactly
# against every one of these 4 occurrences (word2's top 3 bits are always 0
# and the value equals imm1628s directly, no further scaling). A handful of
# other real occurrences (-3088, -528, 2288, -348) share the same
# ins0311=0x11E opcode selector but with imm0002 (bits0-2) set to 1/3/6
# instead of 0 and a second-word bit pattern that doesn't fit this same
# signed-13-bit-immediate formula -- likely a related but differently-scaled
# sibling encoding, not yet independently derived, and deliberately left
# unimplemented rather than guessed at.
#
:add sp, #imm1628s is group=7 & ins0311=0x11E & imm0002=0 & sp ; imm1628s
{
	sp = sp + imm1628s;
}

#
# rA = rB + imm5
# => add rA, rB, #imm5
#
:add regAl, regBl, #imm0812 is group=4 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl + imm0812;
}

#
# rA = sp + imm7
# => add rA, sp, #imm7
#
:add regAl, sp, #imm7 is group=4 & ins0707=1 & ins0304=1 & regAl & sp & imm0812 & imm0506
[ imm7 = (imm0506 << 5) | imm0812; ]
{
	regAl = sp + imm7;
}

#
# rA = sp + imm12
# => add rA, sp, #imm12
#
:add eregA, sp, #imm1627 is group=7 & ins0011=0x8f8 ; eregA & imm1627 & sp
{
    eregA = sp + imm1627;
}

#
# rA = rB + imm12
# => add rA, rb, #imm12
#
:add regA, eregA, #imm1627 is group=7 & ins0411=0x10 & regA ; eregA & imm1627
{
    regA = eregA + imm1627;
}

#
# rA = rB + imm12s
# => add rA, rb, #imm12
#
:add regA, eregA, #imm1627s is group=7 & ins0411=0x13 & regA ; eregA & imm1627s
{
    regA = eregA + imm1627s;
}

#
# rA = rB + -imm12
# => add rA, rb, #imm12
#
:add regA, eregA, #imm14 is group=7 & ins0411=0x12 & regA & imm0405; eregA & imm1627
[ imm14 = -(((imm1627 | (imm0405<<12))^0x3fff)+1);]
{
    regA = eregA + imm14;
}

#
# rA = rB + (imm12 + 4096)
# => add rA, rb, #imm12
#
:add regA, eregA, imm12p4096 is group=7 & ins0411=0x11 & regA ; eregA & imm1627
[ imm12p4096 = imm1627 + 4096; ]
{
    regA = eregA + imm12p4096;
}

#
# rA = rB + packedimm12
# => add rA, rB, #packedimm12
#
:add regA, eregA, packedimm12 is group=7 & ins0411=0x0e & regA ; eregA & packedimm12
{
    regA = eregA + packedimm12;
}

#
# [rA+#imm5] += #imm16s
# add [rA + #imm5], #imm16s
#
:add [eregA + offset], #imm1627s is group=7 & ins0511=0x5E & imm0004 ; eregA & imm1627s
[ offset = imm0004*4; ]
{
    addr:4 = eregA + offset;
    *:4 addr = *addr + imm1627s;
}

#
# [rA+#imm5] += rB
# add [rA + #imm5], rB
#
:add [eregA + offset], eregC is group=7 & ins0011=0x868 ; eregA & eregC & imm1617=0 & imm1823
[ offset = (imm1823<<2); ]
{
    addr:4 = eregA + offset;
    *:4 addr = *addr + eregC;
}

#
# rA = rB + rC
# => add rA, rB, rC
#
:add eregA, eregB, eregC is group=7 & ins0011=0xB4 ; eregA & eregB & eregC & imm1619=0
{
    eregA = eregB + eregC;
}

# Add registers + carry into reg
# rA = rB + rC + C
# => addc rA, rB, rC
#
:addc eregA, eregB, eregC is group=7 & ins0011=0xB8 ; eregA & eregB & eregC & imm1619=0
{
    # TODO: handle carry
    eregA = eregB + eregC;
}

#
# rB_rA += rC * rD (signed)
# => muladd.s rB_rA, rC, rD
#
:muladd.s edregA, eregB, eregC is group=7 & ins0011=0x1fc ; edregA & eregB & eregC & imm1619=0 & imm2828=1
{
    # Zero-extend eregC and eregB
    C:8 = sext(eregC);
    B:8 = sext(eregB); 

    # Multiply and add to edregA
    edregA = edregA + C*B;
}

#
# rB_rA += rC * rD (unsigned)
# => muladd.s rB_rA, rC, rD
#
:muladd.s edregA, eregB, eregC is group=7 & ins0011=0x1fc ; edregA & eregB & eregC & imm1619=0 & imm2828=0
{
    # Zero-extend eregC and eregB
    C:8 = zext(eregC);
    B:8 = zext(eregB); 

    # Multiply and add to edregA
    edregA =edregA + C*B;
}

#
# rB_rA -= rC * rD (signed)
# => mulsub.s rB_rA, rC, rD
#
:mulsub.s edregA, eregB, eregC is group=7 & ins0011=0x1fe ; edregA & eregB & eregC & imm1619=0 & imm2828=1
{
    C:8 = sext(eregC);
    B:8 = sext(eregB);

    edregA = edregA - C*B;
}

#
# rB_rA -= rC * rD (unsigned)
# => mulsub.s rB_rA, rC, rD
#
:mulsub.s edregA, eregB, eregC is group=7 & ins0011=0x1fe ; edregA & eregB & eregC & imm1619=0 & imm2828=0
{
    C:8 = zext(eregC);
    B:8 = zext(eregB);

    edregA = edregA - C*B;
}


###########################################################################################
# Subtract
###########################################################################################

#
# rA = rB - rC
# => sub rA, rB, rC
#
:sub regAl, regBl, regCxl is group=0 & ins0912=0xF & regAl & regBl & regCxl
{
	regAl = regBl - regCxl;
}

#
# [rA+#imm5] -= rB
# sub [rA + #imm5], rB
#
:sub [eregA + offset], eregC is group=7 & ins0011=0x868 ; eregA & eregC & imm1617=2 & imm1823
[ offset = (imm1823<<2); ]
{
    addr:4 = eregA + offset;
    *:4 addr = *addr - eregC;
}

#
# rA = packedimm12 - rB
# => sub bitmask, #packedimm12
#
:sub regA, #packedimm12, eregA is group=7 & ins0411=0x0A & regA ; eregA & packedimm12
{
    regA = packedimm12 - eregA;
}

#
# rA = rB - rC
# => sub rA, rB, rC
#
:sub eregA, eregB, eregC is group=7 & ins0011=0xB4 ; eregA & eregB & eregC & imm1619=2
{
    eregA = eregB - eregC;
}

# Substract registers and not(C)
# rA = rB - rC - !C
# => subc rA, rB, rC
#
:subc eregA, eregB, eregC is group=7 & ins0011=0xB8 ; eregA & eregB & eregC & imm1619=2
{
    # TODO: handle carry !
    eregA = eregB - eregC;
}

#
# rA = rB - packedimm12
# => sub rA, rB, #imm
:sub regA, eregA, #packedimm12 is group=7 & ins0411=0x0f & regA ; eregA & packedimm12
{
    regA = eregA - packedimm12;
}

###########################################################################################
# Multiply
###########################################################################################

#
# rA *= rB
# => mul rA, rB
#
:mul regA, regB is group=0 & ins0812=0x1B & regA & regB
{
	regA = regA * regB;
}

#
# rA = rC * rB
# => mul rA, rC, rB
#
:mul eregA, eregB, eregC is group=7 & ins0011=0x1f0 ; eregA & eregB & eregC & imm1619=0
{
    eregA = eregC * eregB;
}

#
# rB_rA = rC * rD (signed)
# => mul rB_rA, rC, rD
#
:mul edregA, eregB, eregC is group=7 & ins0011=0x1f8 ; edregA & eregB & eregC & imm1619=0 & imm2828=0
{
    # Sign-extend eregC and eregB
    C:8 = sext(eregC);
    B:8 = sext(eregB); 

    # Multiply
    edregA = C*B;
}


#
# rB_rA = rC * rD (unsigned)
# => mul rB_rA, rC, rD
#
:mul.z edregA, eregB, eregC is group=7 & ins0011=0x1f8 ; edregA & eregB & eregC & imm1619=0 & imm2828=1
{
    # Zero-extend eregC and eregB
    C:8 = zext(eregC);
    B:8 = zext(eregB); 

    # Multiply
    edregA = C*B;
}


#
# rA = rB * packedimm12
#
:mul regA, eregA, #packedimm12 is group=7 & ins0411=0x1e & regA ; eregA & imm1623 & packedimm12
{
    regA = eregA * packedimm12;
}

###########################################################################################
# Divide
###########################################################################################

#
# rA = rB / rC (unsigned)
# => div.s rA, rB, rC
#
:div eregA, eregB, eregC is group=7 & ins0011=0x1f4 ; eregA & eregB & eregC & imm1619=0
{

    eregA = eregB / eregC;
}

#
# rA = rC / rB (signed)
# => div.s rA, rC, rB
#
:div.s eregA, eregB, eregC is group=7 & ins0011=0x1f4 ; eregA & eregB & eregC & imm1619=1
{

    eregA = eregB s/ eregC;
}

#
# rA_rB = rC_rD / rE (unsigned, 64-bit dividend/result, single-register divisor)
#
# Separate opcode slot (ins0011=0x1f6) from the 32-bit div/div.s pair above.
# Field layout confirmed against all 17 real ground-truth occurrences: edregA
# (bits 29-31) is the destination pair, edregB (bits 21-23) the dividend
# pair, eregC (bits 24-27) the single-register divisor; bit 20 (imm2020, new
# field -- no prior name existed for this single bit) and bit 12 (imm2828)
# are always 0 in every sample and are pinned rather than left unconstrained.
# Only the unsigned form appears anywhere in ground truth (no signed
# counterpart is added).
#
:div edregA, edregB, eregC is group=7 & ins0011=0x1f6 ; edregA & eregC & edregB & imm2828=0 & imm2020=0 & imm1619=0
{
    edregA = edregB / zext(eregC);
}


###########################################################################################
# Absolute value
###########################################################################################

#
# rA = abs(rB)
#
:abs eregA, eregC is group=7 & ins0011=0x430 ; eregA & eregC & imm1623=0
{
    if (eregC s>=0) goto <skip>;
    eregA = (eregC ^ 0xffffffff) + 1;
    goto inst_next;
<skip>
    eregA = eregC;
}

###########################################################################################
# Max value
###########################################################################################

#
# rA = umax(rB, rC) (unsigned)
#
:umax eregA, eregB, eregC is group=7 & ins0011=0x434 ; eregA & eregB & eregC & imm1619=0
{
    if (eregB >= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

#
# rA = smax(rB, rC) (signed)
#
:smax eregA, eregB, eregC is group=7 & ins0011=0x434 ; eregA & eregB & eregC & imm1619=1
{
    if (eregB s>= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

###########################################################################################
# Min value
###########################################################################################

#
# rA = umin(rB, rC) (unsigned)
#
:umin eregA, eregB, eregC is group=7 & ins0011=0x435 ; eregA & eregB & eregC & imm1619=0
{
    if (eregB <= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

#
# rA = smin(rB, rC) (signed)
#
:smin eregA, eregB, eregC is group=7 & ins0011=0x435 ; eregA & eregB & eregC & imm1619=1
{
    if (eregB s<= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

###########################################################################################
# Saturating add (signed)
###########################################################################################

#
# rA = rB + rC, clamped to [INT32_MIN, INT32_MAX] on signed overflow.
#
# Only one opcode slot (0x439) has been observed in real firmware, always with
# the same fixed register combination (r10 = r10 + r11 (ssat)), so unlike
# smax/smin above there is no confirmed second (unsigned) variant sharing this
# opcode via an imm1619-style flag bit -- the neighboring 0x436-0x438 slots in
# this opcode family remain unconfirmed/unimplemented. imm1619 is deliberately
# left unconstrained here since no competing mnemonic at ins0011=0x439 has been
# observed to require disambiguating against.
#
:sadd.sat eregA, eregB, eregC is group=7 & ins0011=0x439 ; eregA & eregB & eregC
{
    local sum:4 = eregB + eregC;
    local ovf:4 = (eregB ^ sum) & (eregC ^ sum);
    if (ovf s>= 0) goto <noovf>;
    if (eregB s< 0) goto <neg>;
    eregA = 0x7fffffff;
    goto inst_next;
<neg>
    eregA = 0x80000000;
    goto inst_next;
<noovf>
    eregA = sum;
}