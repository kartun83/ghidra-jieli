# unused, confirmed against real ground truth (e.g. "if (r3 != 16320)",
# "if (r7 != 134217728)": values outside the plain-byte range that only
# packedimm12's compressed/shifted forms can represent).
#
:if (regA != #packedimm12) { is group=7 & ins0411=0x8A & regA ; packedimm12 & ifcnt & elsecnt
[
