#
# ifs (rA <= #packedimm12) { ... } else { ... } -- duplicate opcode slot
# (ins0411=0xEA, one below 0xEB above) confirmed against real ground truth
# ("ifs (r8 <= 127)", packedimm12's plain imm2427=0 sub-case) decoding
# identically to 0xEB in every observed bit. This ISA has several confirmed
# duplicate-opcode pairs already (ssync/btbclr's extra slots, packedimm12's
# own imm2427=1/2 duplicate) -- treated the same way here rather than
# guessing at a semantic difference not evidenced by the one real sample.
#
:ifs (regA <= #packedimm12) { is group=7 & ins0411=0xEA & regA ; packedimm12 & ifcnt & elsecnt
[
    # Save instructions count for then and else branches
    thenbranch=ifcnt+1; globalset(inst_next, thenbranch);
    elsebranch=elsecnt; globalset(inst_next, elsebranch);

    ifblock=1; globalset(inst_next, ifblock);
]
{
    if (regA s> packedimm12) goto <else>;
    cres=1;
    goto <end>;

<else>
    cres=0;
<end>
}


