# imm1623=0x80 for exactly this reason) -- what specifically imm1623=0x05
# means here isn't independently known, only that this exact byte pairing is
# what real firmware emits.
#
:ifs (regA >= eregC) { is group=7 & ins0411=0xD1 & regA ; eregC & imm1623=0x05 & ifcnt & elsecnt
[
